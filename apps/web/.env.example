# Team values. For a fully local setup, run bun run setup instead (see SETUP.md).
# Where the API runs. next.config.ts proxies /api/* there (server side).
API_URL="http://localhost:3011"
# uniAuth's origin, used for sign-out and the account page. Baked into the browser bundle
# at build time. Production: https://auth.psstee.me
NEXT_PUBLIC_UNIAUTH_URL="https://auth-dev.psstee.me"
