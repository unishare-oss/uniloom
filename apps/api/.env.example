# Team values (Tailscale + dev uniAuth). For a fully local setup, run bun run setup instead (see SETUP.md).
DATABASE_URL="postgresql://uniloom:uniloom@oracle.tailcb9a25.ts.net:5434/uniloom"
PORT=3011
# The web origin (it proxies /api to this API). A loopback IP, not localhost: uniAuth only
# redirects local clients to one.
BETTER_AUTH_URL="http://127.0.0.1:3013"
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# uniAuth: the shared dev server here, or your own local one (see SETUP.md)
UNIAUTH_ISSUER="https://auth-dev.psstee.me/api/auth"
UNIAUTH_CLIENT_ID="replace-with-local-client-id"
UNIAUTH_CLIENT_SECRET="replace-with-local-client-secret"
# Uniloom's /mcp on the web origin: the audience of agent tokens (uniAuth must accept it)
MCP_RESOURCE="http://127.0.0.1:3013/mcp"

# Optional tracing. Leave the endpoint unset for local runs without a collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=uniloom-api
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_SDK_DISABLED=true
# uniAuth directory: a machine client with directory:resolve, so owners can add people by email who
# never signed in to Uniloom (scripts/create-machine-client.ts in uniauth). Both unset = off:
# add-by-email then only finds people who already signed in here.
# UNIAUTH_DIRECTORY_CLIENT_ID=
# UNIAUTH_DIRECTORY_CLIENT_SECRET=
# v1 identity events: uniAuth delivers them for the machine client above (its identity_events_uri must be
# <api origin>/api/uniauth/identity-events). Optional:
# UNIAUTH_EVENTS_EXTRA_AUDIENCES=       # the old machine client id, only while a credential rotation overlaps
# UNIAUTH_RECONCILE_HOURS=6             # how often to catch up with uniAuth's change feed
# GitHub App (links pull requests to tickets). The webhook secret is the one set on the App; the slug
# (github.com/apps/<slug>) only builds the Install button in Settings. Unset secret: the webhook answers 503.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=
