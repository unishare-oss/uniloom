{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts src/notification-worker.ts --target bun --outdir dist",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:prod": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:seed": "bun scripts/seed.ts",
    "lint": "oxlint --type-aware src/ test/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "api:spec": "bun scripts/openapi.ts",
    "notifications:worker": "bun src/notification-worker.ts",
    "notifications:retry": "bun scripts/retry-review-event.ts",
    "github:retry": "bun scripts/retry-github-deliveries.ts"
  },
  "dependencies": {
    "@hono/otel": "^1.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/hono-api-reference": "^0.12.11",
    "better-auth": "^1.7.6",
    "dotenv": "^18.0.7",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.5",
    "jose": "^6",
    "pg": "^8.16.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
