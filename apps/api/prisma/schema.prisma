generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tables are added one feature at a time; see docs/plans/. Rules that depend on a
// project's switches live in the rules engine, not here.

// Better Auth tables. People are matched by uniAuth `sub` through Account
// (providerId "uniauth", accountId = sub), never by email.

/// A person, as Better Auth stores them.
model User {
  id             String    @id
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  /// When the user accepted Uniloom's Terms and Privacy Policy. Null until they do.
  consentGivenAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reviewEvents ReviewEvent[]
  notifications Notification[]

  sessions      Session[]
  accounts      Account[]
  memberships   Member[]
  assignedItems Item[]    @relation("ItemAssignee")
  createdItems  Item[]    @relation("ItemCreatedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ProjectMode {
  STANDARD
  GUIDED
}

enum Role {
  OWNER
  MANAGER
  MEMBER
}

/// A mode is a preset of the switch columns; owners can change switches afterwards.
/// States are locked when `mode` is GUIDED, since its rules rely on them.
/// The migration adds a CHECK that checklist limits are at least 1 and min <= max.
model Project {
  id                String        @id @default(uuid(7)) @db.Uuid
  name              String
  /// Items are numbered `<keyPrefix>-<number>`, e.g. UG-12.
  keyPrefix         String        @unique
  mode              ProjectMode
  checklistRequired Boolean
  /// Fewest done-when items per checklist; null = no limit. Guided preset: 3 (recommended).
  checklistMin      Int?
  /// Most done-when items per checklist; null = no limit. Guided preset: 6 (recommended).
  checklistMax      Int?
  designRequired    Boolean
  approvalRequired  Boolean
  approverNotAuthor Boolean
  plannedVsActual   Boolean
  /// When off, a member can't claim a free ticket; they can still unclaim their own.
  selfClaimAllowed  Boolean       @default(true)
  /// Next item number. Increment it in the same transaction that creates the item.
  nextItemNumber    Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  reviewEvents ReviewEvent[]
  notifications Notification[]

  members Member[]
  states  State[]
  items   Item[]

  @@map("project")
}

model Member {
  projectId String    @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role
  createdAt   DateTime  @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("member")
}

// ---------------------------------------------------------------------------
// Items: workflow states, work items and blocked-by links (docs/plans/04-items.md)

enum StateCategory {
  BACKLOG
  UNSTARTED
  STARTED
  DONE
  CANCELED
}

/// A board column. Each project gets its mode's states when it is created. Guided
/// states carry a stable `key` (triage, backlog, aligning, ready, in_progress, blocked,
/// in_review, done, canceled) that the rules use.
model State {
  id          String        @id @default(uuid(7)) @db.Uuid
  projectId String        @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  key         String?
  category    StateCategory
  position    Int

  items Item[]

  @@unique([projectId, name])
  @@unique([projectId, key])
  @@map("state")
}

/// Guided: FEATURE → SLICE. Standard: TASK → SUBTASK.
enum ItemKind {
  TASK
  SUBTASK
  FEATURE
  SLICE
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

/// A piece of work, shown as `<keyPrefix>-<number>` (UG-12).
model Item {
  id          String    @id @default(uuid(7)) @db.Uuid
  projectId String    @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  kind        ItemKind
  title       String
  /// Markdown, may contain Mermaid diagrams.
  description String    @default("")
  /// NoAction: a state in use can't be deleted, but a project delete still cascades.
  stateId     String    @db.Uuid
  state       State     @relation(fields: [stateId], references: [id], onDelete: NoAction)
  priority    Priority  @default(NONE)
  assigneeId  String?
  assignee    User?     @relation("ItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// NoAction: an item with children can't be deleted.
  parentId    String?   @db.Uuid
  parent      Item?     @relation("ItemParent", fields: [parentId], references: [id], onDelete: NoAction)
  children    Item[]    @relation("ItemParent")
  createdById String?
  createdBy   User?     @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set when the item is deleted: it disappears from the API, but the row is kept.
  deletedAt   DateTime?

  reviewEvents ReviewEvent[]
  notifications Notification[]

  blockedBy ItemBlock[] @relation("BlockedItem")
  blocking  ItemBlock[] @relation("BlockerItem")
  checklist ChecklistEntry[]

  @@unique([projectId, number])
  @@index([projectId, stateId, deletedAt])
  @@index([parentId])
  @@index([assigneeId])
  @@map("item")
}

/// `blocked` waits on `blocker`: a many-to-many link of item with itself. The migration
/// adds a CHECK that they differ.
model ItemBlock {
  blockedId String @db.Uuid
  blocked   Item   @relation("BlockedItem", fields: [blockedId], references: [id], onDelete: Cascade)
  blockerId String @db.Uuid
  blocker   Item   @relation("BlockerItem", fields: [blockerId], references: [id], onDelete: Cascade)

  @@id([blockedId, blockerId])
  @@index([blockerId])
  @@map("item_block")
}

/// One done-when entry of an item. Positions run 0..n-1 per item.
model ChecklistEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  itemId    String   @db.Uuid
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  /// Free text: a commit SHA, test name or link.
  evidence  String?
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, position])
  @@map("checklist_entry")
}

/// Durable review submission; the body stays historical while delivery metadata changes.
model ReviewEvent {
  id String @id @default(uuid(7)) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemId String @db.Uuid
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  fromStateId String @db.Uuid
  toStateId String @db.Uuid
  fromStateKey String?
  toStateKey String
  submittedAt DateTime @default(now())
  recipientIds String[]
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  processedAt DateTime?
  failedAt DateTime?
  lastError String?
  notifications Notification[]

  @@index([processedAt, failedAt, nextAttemptAt, id])
  @@index([itemId, submittedAt, id])
  @@map("review_event")
}

/// Separate inbox/read state for each recipient of each actual submission.
model Notification {
  id String @id @default(uuid(7)) @db.Uuid
  eventId String @db.Uuid
  event ReviewEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipientId String
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemId String @db.Uuid
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  readAt DateTime?

  @@unique([eventId, recipientId])
  @@index([recipientId, createdAt, id])
  @@index([recipientId, itemId, createdAt, id])
  @@map("notification")
}
