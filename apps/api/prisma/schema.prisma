generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tables are added one feature at a time; see docs/plans/. Rules that depend on a
// project's switches live in the rules engine, not here.

// Better Auth tables. People are matched by uniAuth `sub` through Account
// (providerId "uniauth", accountId = sub), never by email.

/// A person, as Better Auth stores them.
model User {
  id             String    @id
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  /// When the user accepted Uniloom's Terms and Privacy Policy. Null until they do.
  consentGivenAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reviewEvents  ReviewEvent[]
  notifications Notification[]
  activities    Activity[]

  sessions            Session[]
  accounts            Account[]
  memberships         Member[]
  assignedItems       Item[]        @relation("ItemAssignee")
  createdItems        Item[]        @relation("ItemCreatedBy")
  documents           Document[]    @relation("DocumentAuthor")
  invites             Invite[]      @relation("InviteCreatedBy")
  joinRequests        JoinRequest[]
  decidedJoinRequests JoinRequest[] @relation("JoinRequestDecidedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ProjectMode {
  STANDARD
  GUIDED
}

enum Role {
  OWNER
  MANAGER
  MEMBER
}

/// A mode is a preset of the switch columns; owners can change switches afterwards.
/// States are locked when `mode` is GUIDED, since its rules rely on them.
/// The migration adds a CHECK that checklist limits are at least 1 and min <= max.
model Project {
  id                String      @id @default(uuid(7)) @db.Uuid
  name              String
  /// Items are numbered `<keyPrefix>-<number>`, e.g. UG-12.
  keyPrefix         String      @unique
  mode              ProjectMode
  checklistRequired Boolean
  /// Fewest done-when items per checklist; null = no limit. Guided preset: 3 (recommended).
  checklistMin      Int?
  /// Most done-when items per checklist; null = no limit. Guided preset: 6 (recommended).
  checklistMax      Int?
  designRequired    Boolean
  approvalRequired  Boolean
  approverNotAuthor Boolean
  plannedVsActual   Boolean
  /// When off, a member can't claim a free ticket; they can still unclaim their own.
  selfClaimAllowed  Boolean     @default(true)
  /// Next item number. Increment it in the same transaction that creates the item.
  nextItemNumber    Int         @default(1)
  /// Soft delete (ADR-0020): set when an Owner deletes the project; every lookup skips it.
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  reviewEvents  ReviewEvent[]
  notifications Notification[]
  activities    Activity[]

  members      Member[]
  states       State[]
  items        Item[]
  labels       Label[]
  documents    Document[]
  invites      Invite[]
  joinRequests JoinRequest[]

  @@map("project")
}

model Member {
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("member")
}

// ---------------------------------------------------------------------------
// Items: workflow states, work items and blocked-by links (docs/archived/04-items.md)

enum StateCategory {
  BACKLOG
  UNSTARTED
  STARTED
  DONE
  CANCELED
}

/// A board column. Each project gets its mode's states when it is created. Guided
/// states carry a stable `key` (triage, backlog, aligning, ready, in_progress, blocked,
/// in_review, done, canceled) that the rules use.
model State {
  id        String        @id @default(uuid(7)) @db.Uuid
  projectId String        @db.Uuid
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  key       String?
  category  StateCategory
  position  Int

  items Item[]

  @@unique([projectId, name])
  @@unique([projectId, key])
  @@map("state")
}

/// Guided: FEATURE → SLICE. Standard: TASK → SUBTASK.
enum ItemKind {
  TASK
  SUBTASK
  FEATURE
  SLICE
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

/// A piece of work, shown as `<keyPrefix>-<number>` (UG-12).
model Item {
  id          String    @id @default(uuid(7)) @db.Uuid
  projectId   String    @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  kind        ItemKind
  title       String
  /// Markdown, may contain Mermaid diagrams.
  description String    @default("")
  /// NoAction: a state in use can't be deleted, but a project delete still cascades.
  stateId     String    @db.Uuid
  state       State     @relation(fields: [stateId], references: [id], onDelete: NoAction)
  priority    Priority  @default(NONE)
  assigneeId  String?
  assignee    User?     @relation("ItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// NoAction: an item with children can't be deleted.
  parentId    String?   @db.Uuid
  parent      Item?     @relation("ItemParent", fields: [parentId], references: [id], onDelete: NoAction)
  children    Item[]    @relation("ItemParent")
  createdById String?
  createdBy   User?     @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set when the item is deleted: it disappears from the API, but the row is kept.
  deletedAt   DateTime?

  reviewEvents  ReviewEvent[]
  notifications Notification[]
  activities    Activity[]

  blockedBy ItemBlock[]      @relation("BlockedItem")
  blocking  ItemBlock[]      @relation("BlockerItem")
  checklist ChecklistEntry[]
  labels    ItemLabel[]

  /// Documents that belong to this ticket (e.g. a feature's spec).
  homeDocuments    Document[]     @relation("DocumentHome")
  /// Documents created from this ticket.
  createdDocuments Document[]     @relation("DocumentCreatedFrom")
  /// Knowledge documents linked to this ticket.
  documentLinks    ItemDocument[]
  /// Tech debt documents this ticket fixed.
  fixedDocuments   Document[]     @relation("DocumentFixedBy")

  @@unique([projectId, number])
  @@index([projectId, stateId, deletedAt])
  @@index([parentId])
  @@index([assigneeId])
  @@map("item")
}

/// `blocked` waits on `blocker`: a many-to-many link of item with itself. The migration
/// adds a CHECK that they differ.
model ItemBlock {
  blockedId String @db.Uuid
  blocked   Item   @relation("BlockedItem", fields: [blockedId], references: [id], onDelete: Cascade)
  blockerId String @db.Uuid
  blocker   Item   @relation("BlockerItem", fields: [blockerId], references: [id], onDelete: Cascade)

  @@id([blockedId, blockerId])
  @@index([blockerId])
  @@map("item_block")
}

/// One done-when entry of an item. Positions run 0..n-1 per item.
model ChecklistEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  itemId    String   @db.Uuid
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  /// Free text: a commit SHA, test name or link.
  evidence  String?
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, position])
  @@map("checklist_entry")
}

/// Durable review submission; the body stays historical while delivery metadata changes.
model ReviewEvent {
  id            String         @id @default(uuid(7)) @db.Uuid
  projectId     String         @db.Uuid
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemId        String         @db.Uuid
  item          Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  fromStateId   String         @db.Uuid
  toStateId     String         @db.Uuid
  fromStateKey  String?
  toStateKey    String
  submittedAt   DateTime       @default(now())
  recipientIds  String[]
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  processedAt   DateTime?
  failedAt      DateTime?
  lastError     String?
  notifications Notification[]

  @@index([processedAt, failedAt, nextAttemptAt, id])
  @@index([itemId, submittedAt, id])
  @@map("review_event")
}

/// One change to an item, made by a person or by their agent. Written in the same
/// transaction as the change. `detail` is typed in items/item.schema.ts.
model Activity {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The OAuth client of the agent; null for a change made on the website.
  clientId  String?
  /// The client's registered name, self-declared: shown, never used for access.
  agentName String?
  action    String
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemId    String?  @db.Uuid
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  detail    Json
  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@map("activity")
}

/// Separate inbox/read state for each recipient of each actual submission.
model Notification {
  id          String      @id @default(uuid(7)) @db.Uuid
  eventId     String      @db.Uuid
  event       ReviewEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  projectId   String      @db.Uuid
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemId      String      @db.Uuid
  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  readAt      DateTime?

  @@unique([eventId, recipientId])
  @@index([recipientId, createdAt, id])
  @@index([recipientId, itemId, createdAt, id])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Labels (docs/archived/27-labels.md)

enum LabelColor {
  GRAY
  RED
  ORANGE
  YELLOW
  GREEN
  BLUE
  PURPLE
  PINK
}

/// A project's label. Two labels with the same `group` can't be on one item; a label
/// without a group combines freely. The group is plain text, so there is no group table.
model Label {
  id        String     @id @default(uuid(7)) @db.Uuid
  projectId String     @db.Uuid
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     LabelColor
  group     String?
  createdAt DateTime   @default(now())

  items ItemLabel[]

  @@unique([projectId, name])
  @@map("label")
}

/// A label on an item. Deleting either side removes the link.
model ItemLabel {
  itemId  String @db.Uuid
  item    Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  labelId String @db.Uuid
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([itemId, labelId])
  @@index([labelId])
  @@map("item_label")
}

enum DocumentKind {
  BRIEF
  PROPOSAL
  SPEC
  REFERENCE
  ADR
  TECH_DEBT
  SLO
  SLA
}

/// ADR: PROPOSED, ACCEPTED, REJECTED, SUPERSEDED. Tech debt (plan 41): OPEN, FIXED, WONT_FIX.
/// Which moves a kind allows is a rule in the documents module, not a constraint. See ADR-0014.
enum DocumentStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SUPERSEDED
  OPEN
  FIXED
  WONT_FIX
}

/// A project's knowledge document: Markdown with a kind and a purpose, no workflow.
/// Archived documents keep their rows (`archivedAt`). See ADR-0013.
model Document {
  id                String          @id @default(uuid(7)) @db.Uuid
  projectId         String          @db.Uuid
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind              DocumentKind
  title             String
  purpose           String          @default("")
  body              String          @default("")
  authorId          String?
  author            User?           @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  /// Set: belongs to that ticket (e.g. a feature's spec), not listed in Knowledge.
  /// Null: a project document in Knowledge. See ADR-0014.
  homeItemId        String?         @db.Uuid
  homeItem          Item?           @relation("DocumentHome", fields: [homeItemId], references: [id], onDelete: Cascade)
  /// The ticket it was created from, set once: "from TG-21".
  createdFromItemId String?         @db.Uuid
  createdFromItem   Item?           @relation("DocumentCreatedFrom", fields: [createdFromItemId], references: [id], onDelete: SetNull)
  /// Optional provenance for a spec; one proposal may support many specs.
  sourceProposalId  String?         @db.Uuid
  sourceProposal    Document?       @relation("SpecSourceProposal", fields: [sourceProposalId], references: [id], onDelete: SetNull)
  derivedSpecs      Document[]      @relation("SpecSourceProposal")
  links             ItemDocument[]
  /// ADR-7: per project and kind. Null for kinds without a number.
  number            Int?
  status            DocumentStatus?
  /// ADR only: the newer ADR that replaced this one.
  supersededById    String?         @db.Uuid
  supersededBy      Document?       @relation("DocumentSuperseded", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes        Document[]      @relation("DocumentSuperseded")
  /// Tech debt only: the Done ticket that fixed it.
  fixedByItemId     String?         @db.Uuid
  fixedByItem       Item?           @relation("DocumentFixedBy", fields: [fixedByItemId], references: [id], onDelete: SetNull)

  @@unique([projectId, kind, number])
  @@index([projectId, updatedAt])
  @@index([homeItemId])
  @@index([sourceProposalId])
  @@map("document")
}

/// Knowledge documents linked to tickets, many to many. Ids only, no content.
model ItemDocument {
  itemId     String   @db.Uuid
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([itemId, documentId])
  @@index([documentId])
  @@map("item_document")
}

// ---------------------------------------------------------------------------
// Invite links and join requests (docs/plans/43-invite-links.md, 44-join-approval.md,
// ADR-0015)

/// A project's invite link. A project has at most one where `revokedAt` is null (a
/// partial unique index in the migration); replaced and deleted links keep their rows.
/// The migration also adds a CHECK that `maxUses` is null or at least 1.
model Invite {
  id           String    @id @default(uuid(7)) @db.Uuid
  projectId    String    @db.Uuid
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 32 random bytes, base64url. The only secret of the link, stored as is.
  token        String    @unique
  /// When on, people ask to join and an owner or manager lets them in (plan 44).
  joinApproval Boolean   @default(false)
  /// How many people the link lets in; null = no limit.
  maxUses      Int?
  /// People who used a slot. Only ever goes up.
  useCount     Int       @default(0)
  expiresAt    DateTime
  createdById  String?
  createdBy    User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  /// Set when the link is deleted or replaced: it stops working at once.
  revokedAt    DateTime?

  joinRequests JoinRequest[]

  @@index([projectId])
  @@map("invite")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  /// The person took their request back (plan 45). Like DECLINED, they may ask again.
  CANCELED
}

/// Someone asked to join through an invite link that needs approval. One row per person
/// per link, so they use one slot however often they ask; decided rows are kept for that.
/// A person has at most one PENDING row per project (a partial unique index in the
/// migration). Requests outlive their link and never expire.
model JoinRequest {
  id          String            @id @default(uuid(7)) @db.Uuid
  projectId   String            @db.Uuid
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteId    String            @db.Uuid
  invite      Invite            @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  status      JoinRequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?             @relation("JoinRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// When they last asked: asking again after a decline moves it.
  requestedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([inviteId, userId])
  @@index([projectId, status])
  @@map("join_request")
}
